# Railway supplies PORT automatically. Do not set it manually.
APP_ENV=production
# The deployed PHP API uses these names first, then Railway's native MYSQL* names.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASS=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_SSL_MODE=auto

# Alternative: set MYSQL_URL to the Railway MySQL service's mysql:// URL and
# remove DB_HOST/DB_PORT/DB_USER/DB_PASS/DB_NAME if they are also present.
# MYSQL_URL=mysql://user:password@host:port/database

FRONTEND_URL=https://your-app.up.railway.app
# Exact frontend origin only. Do not use * when credentialed sessions are used.
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app
SESSION_COOKIE_SAMESITE=Lax
# Keep this stable across deploys so signed CAPTCHA challenges remain verifiable.
ALTCHA_HMAC_KEY=generate-a-random-32-byte-or-longer-secret

# Resend transactional email. MAIL_FROM must be an address/domain verified in Resend.
RESEND_API_KEY=re_replace_with_your_resend_key
MAIL_FROM="LLB Accountants <no-reply@your-verified-domain.example>"
MAIL_FROM_NAME=LLB Accountants

# Google sign-in / OAuth integration.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Optional hCaptcha keys; these can also be read from the settings table.
HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET=your_hcaptcha_secret_key

# Optional when using a MySQL provider that requires TLS.
# DB_SSL_MODE=required
# DB_SSL_CA=/path/to/ca.pem

# For a separately hosted frontend, set NEXT_PUBLIC_BACKEND_ORIGIN to the API
# origin at build time and set CORS_ALLOWED_ORIGINS to the exact frontend origin.
# Leave blank for the current single Railway service (frontend and API same origin).
NEXT_PUBLIC_BACKEND_ORIGIN=
NEXT_PUBLIC_BACKEND_BASE_PATH=/capstone1
