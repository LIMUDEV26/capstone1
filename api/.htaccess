# ── Environment variables passed through to PHP ──────────────────────────────
# CORS_ALLOWED_ORIGINS and other secrets should be set in the server-level
# Apache config or httpd.conf (SetEnv / SetEnvIf). The entries below are
# examples for local dev; REMOVE or override them in production.
SetEnv CORS_ALLOWED_ORIGINS "http://localhost:3000,http://127.0.0.1:3000"
SetEnv FRONTEND_BASE_URL "http://localhost:3000"
# SetEnv SETUP_SECRET "replace-with-a-random-secret"
# SetEnv DB_USER "llb_app"
# SetEnv DB_PASS "your-db-password"
# ── SMTP credentials are NO LONGER SET HERE ──────────────────────────────────
# Hardcoding them in a tracked file leaked a live Gmail app password into git
# history (docs/SECURITY_HARDENING.md, findings C1/C3). They are now loaded by
# api/config.php from api/.secrets.php, which is git-ignored and lives only on
# the server. Copy api/.secrets.example.php -> api/.secrets.php to set them.
# SetEnv SMTP_USERNAME "you@example.com"
# SetEnv SMTP_PASSWORD "your-16-char-app-password"
# SetEnv SMTP_FROM_EMAIL "you@example.com"
# SMTP_DEBUG echoes PHPMailer's SMTP conversation onto stdout, which corrupts
# JSON API responses. Keep it 0 unless actively debugging on a scratch host.
SetEnv SMTP_DEBUG "0"

# Disable PHP error output — stack traces and absolute paths must never
# reach the client in production.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_value error_reporting 0
</IfModule>
# PHP 8.x (CGI/FPM via mod_proxy_fcgi)
<IfModule mod_fcgid.c>
    FcgidInitialEnv PHP_INI_SCAN_DIR ""
</IfModule>

# ── Security headers for all API responses ───────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header always unset Server

    # The root .htaccess CSP is inherited here, but it is written for the HTML
    # frontend and is far too permissive for API responses. Drop it so the
    # strict API policy set by setApiHardeningHeaders() in api/utils.php is the
    # only one that applies. Endpoints that stream files rather than JSON set
    # their own policy explicitly (see api/serve-file.php).
    Header always unset Content-Security-Policy
</IfModule>
# ── Never serve dotfiles from the API directory ──────────────────────────────
# api/.user.ini and api/.altcha_hmac_key both returned HTTP 200. The latter is
# the HMAC key ALTCHA signs captcha solutions with, so leaking it lets an
# attacker mint valid solutions without doing any proof-of-work. The root
# .htaccess dotfile rule covers this too; repeating it here keeps the guard
# next to the files it protects.
<FilesMatch "^\.|\.(sql|log|bak|old|orig|tmp|ini|lock|swp|swo|phar|key|pem|crt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
